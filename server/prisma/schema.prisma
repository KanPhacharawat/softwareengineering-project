generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  SUPERVISOR
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique
  name               String
  role               Role
  passwordHash       String
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  supervises         Team[]              @relation("TeamSupervisor")
  memberships        TeamMember[]
  milestones         Milestone[]         @relation("MilestoneCreatedBy")
  closedMilestones   Milestone[]         @relation("MilestoneClosedBy")
  submissions        Submission[]        @relation("SubmissionSubmittedBy")
  createdSubmissions Submission[]        @relation("SubmissionCreatedBy")
  feedbacks          Feedback[]
  submittedVersions  SubmissionVersion[] @relation("VersionSubmittedBy")
  revisionRequests   RevisionRequest[]   @relation("RevisionRequestedBy")
}

model Team {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  supervisorId String       @db.Uuid
  supervisor   User         @relation("TeamSupervisor", fields: [supervisorId], references: [id])
  members      TeamMember[]
  milestones   Milestone[]
}

/// AS-01: a student belongs to exactly one team, so userId is unique.
model TeamMember {
  teamId String @db.Uuid
  userId String @unique @db.Uuid
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model Milestone {
  id          String      @id @default(uuid()) @db.Uuid
  teamId      String      @db.Uuid
  title       String
  description String?
  dueAt       DateTime    @db.Timestamptz(3)
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  closedAt    DateTime?   @db.Timestamptz(3)
  closedById  String?     @db.Uuid
  team        Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User        @relation("MilestoneCreatedBy", fields: [createdById], references: [id])
  closedBy    User?       @relation("MilestoneClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  submission  Submission?

  @@index([teamId])
}

model Submission {
  id               String              @id @default(uuid()) @db.Uuid
  milestoneId      String              @unique @db.Uuid
  title            String
  description      String?
  link             String
  /// Last student who saved it (AC-16). createdById is the original submitter and never changes (#55).
  submittedById    String              @db.Uuid
  createdById      String              @db.Uuid
  submittedAt      DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  milestone        Milestone           @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  submittedBy      User                @relation("SubmissionSubmittedBy", fields: [submittedById], references: [id])
  createdBy        User                @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  /// F-06: number of the latest SubmissionVersion; the title/description/link above mirror that version.
  currentVersion   Int                 @default(1)
  versions         SubmissionVersion[]
  revisionRequests RevisionRequest[]
  feedbacks        Feedback[]
}

/// F-06: one row per (re)submitted version. Only the current version is ever updated.
model SubmissionVersion {
  id              String           @id @default(uuid()) @db.Uuid
  submissionId    String           @db.Uuid
  versionNumber   Int
  title           String
  description     String?
  link            String
  submittedById   String           @db.Uuid
  submittedAt     DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  submission      Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submittedBy     User             @relation("VersionSubmittedBy", fields: [submittedById], references: [id])
  feedback        Feedback?
  revisionRequest RevisionRequest?

  @@unique([submissionId, versionNumber])
}

/// F-06: at most one revision request per version (unique versionId), status is derived.
model RevisionRequest {
  id            String            @id @default(uuid()) @db.Uuid
  submissionId  String            @db.Uuid
  versionId     String            @unique @db.Uuid
  reason        String
  dueAt         DateTime          @db.Timestamptz(3)
  requestedById String            @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  submission    Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version       SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedBy   User              @relation("RevisionRequestedBy", fields: [requestedById], references: [id])

  @@index([submissionId])
}

model Feedback {
  id           String            @id @default(uuid()) @db.Uuid
  submissionId String            @db.Uuid
  /// F-06 BR-08: one feedback per version.
  versionId    String            @unique @db.Uuid
  authorId     String            @db.Uuid
  comment      String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  submission   Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  version      SubmissionVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  author       User              @relation(fields: [authorId], references: [id])

  @@index([authorId])
  @@index([submissionId])
}

/// Session store table used by connect-pg-simple (F-01). Shape must match that library.
model session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}
