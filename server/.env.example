# Copy to .env and fill in real values. Never commit .env.
# Every variable the server reads is listed here. Production values live in Secret Manager / Cloud Run,
# see docs/labs/lab-05/deployment.md.

# PostgreSQL connection string (Prisma + session store). Secret in production.
DATABASE_URL=postgresql://app:app@localhost:5433/cpms_dev
# Separate database used by `npm test`; it is wiped and re-seeded on every run. Local/CI only.
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/cpms_test
# Random string of 32+ characters, e.g. `openssl rand -hex 32`. Secret in production.
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
# Password for the seeded demo accounts. Optional locally (defaults to the README demo password);
# required in production (not the default). Secret in production.
SEED_PASSWORD=
# HTTP port. Cloud Run sets it (8080); 3000 locally.
PORT=3000
# development | test | production. production turns on Secure cookies and stricter checks.
NODE_ENV=development
