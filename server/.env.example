# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql://app:app@localhost:5433/cpms_dev
# Separate database used by `npm test`; it is wiped and re-seeded on every run.
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/cpms_test
# Random string of 32+ characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-random-32-plus-character-string
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:5173
