{
  "name": "cpms",
  "private": true,
  "description": "Course Project Management System (CPE 334 Theme 6)",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w server && npm run build -w web",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "test": "npm test -w server",
    "test:e2e": "npm run test:e2e -w web",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.3.0"
  }
}
